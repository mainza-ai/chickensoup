# API Configuration
PORT=8000
HOST=0.0.0.0

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# LLM Provider Fallback Chain (comma-separated, in order of preference)
# For local: omlx,ollama,lmstudio
# For cloud: nvidia,openrouter,custom
LLM_FALLBACK_CHAIN=omlx,ollama,lmstudio

# LLM Providers Base URLs
OMLX_API_URL=http://localhost:9000/v1
OLLAMA_API_URL=http://localhost:11434/v1
LMSTUDIO_API_URL=http://localhost:1234/v1

# Cloud LLM Providers
NVIDIA_API_KEY=
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_API_URL=
CUSTOM_LLM_MODELS=

# LLM provider type: "local" (auto-discover fallback chain) or "cloud" (use specified provider)
# When "cloud", LLM_FALLBACK_CHAIN determines which cloud providers to try
LLM_PROVIDER_TYPE=local

# Active Override (empty = auto-discover)
LLM_ACTIVE_PROVIDER=
LLM_ACTIVE_MODEL=

# Quantum Hardware Backends (simulated by default)
QUANTUM_SIMULATION_BACKEND=qiskit
IBM_API_TOKEN=
DWAVE_API_TOKEN=
IONQ_API_TOKEN=
QUANTUM_HARDWARE_ENABLED=false

# Wiki Ingest Settings
WIKI_AUTO_CREATE=true
WIKI_MIN_CONFIDENCE=0.5
WIKI_DATA_DIR=wiki
WIKI_BACKUP_ENABLED=true
WIKI_BACKUP_DIR=backups
WIKI_BACKUP_RETENTION_DAYS=30
WIKI_AUTO_COMMIT=false
WIKI_RECONCILE_ON_STARTUP=true

# Neo4j Database Backup (creates portable neo4j-admin dump files)
NEO4J_BACKUP_ENABLED=true
NEO4J_BACKUP_DIR=backups/neo4j
NEO4J_BACKUP_RETENTION_DAYS=30
NEO4J_BACKUP_INTERVAL_HOURS=24
NEO4J_URI_HOST_DATA=/var/lib/docker/volumes/chickensoup_neo4j_data/_data
NEO4J_CONTAINER_NAME=chickensoup-neo4j
NEO4J_DATA_VOLUME=chickensoup_neo4j_data

# Chat-to-Wiki Periodic Conversion
CHAT_WIKI_CONVERSION_ENABLED=false
CHAT_WIKI_MIN_CONVERSATION_LENGTH=10
CHAT_WIKI_CHECK_INTERVAL_SECONDS=300
CHAT_WIKI_IDLE_TIMEOUT_MINUTES=30
CHAT_WIKI_USER_ENTITY_NAME=Primary Researcher

# Orchestrator timeout (seconds)
ORCHESTRATOR_TIMEOUT_SECONDS=120

# Security & Rate Limiting
API_KEY=
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
RATE_LIMITING_ENABLED=true
REQUEST_RATE_LIMIT_PER_MINUTE=20
REQUEST_RATE_LIMIT_BURST=5
REQUEST_MAX_BODY_BYTES=1048576

# Request tracing
REQUEST_ID_HEADER=X-Request-ID

# Checkpointer backend (redis or memory)
CHECKPOINT_BACKEND=redis

# LLM Client & Circuit Breaker
LLM_CLIENT_TIMEOUT=30.0
LLM_CLIENT_CLOUD_TIMEOUT=30.0
LLM_CLIENT_LOCAL_TIMEOUT=120.0
LLM_CLIENT_MAX_TOKENS=2048
LLM_CLIENT_HIGH_PRIORITY_CONCURRENCY=2
LLM_CLIENT_LOW_PRIORITY_CONCURRENCY=2
MAX_CONCURRENT_LLM_REQUESTS=4
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_RECOVERY_TIMEOUT=120

# ==============================================================================
# Living Almanac & last30days Evidence Ingestion Configuration
# ==============================================================================

# Enable live evidence fetching via last30days engine (default: false)
LAST30DAYS_ENABLED=false

# Full path to last30days executable or script (if not globally on PATH)
# If empty, auto-resolves to last30days-skill/skills/last30days/scripts/last30days.py
LAST30DAYS_BINARY_PATH=

# Monthly spend limit in USD for scheduled ingestion runs
LAST30DAYS_MONTHLY_BUDGET_USD=20.0

# Estimated cost in USD per pulse pull (used to track ceiling limit)
LAST30DAYS_COST_PER_PULL_USD=0.50

# Free courtesy limits configurations
FREE_TIER_ENABLED=true
FREE_TIER_REQUESTS_PER_HOUR=60

# Idle user monitoring threshold before triggering background pulse pulls (in minutes)
IDLE_THRESHOLD_MINUTES=0.5

# Network request/subprocess timeout for pulse pulls (script needs ~58s cold start)
LAST30DAYS_PULSE_TIMEOUT_SECONDS=300

# Max claim evidence parsed per pulse pull
LAST30DAYS_MAX_CLAIMS_PER_PULSE=50

# Enable/disable general background scheduled pulsing
LAST30DAYS_PULSE_ENABLED=false

# Weight of social metrics (e.g. likes, shares) in wavefunction scoring
CLAIM_WAVEFUNCTION_SOCIAL_TRACTION_WEIGHT=0.15

# Half-life of social traction decay in days
SOCIAL_TRACTION_HALF_LIFE_DAYS=7.0
SOCIAL_TRACTION_DECAY_ENABLED=true

# Cadence interval (in hours) for autonomous HTML almanac brief generation
ALMANAC_GENERATION_INTERVAL_HOURS=24

# Enable dry-run generation by default (safe mode, no files/budget consumed)
ALMANAC_DRY_RUN_DEFAULT=true

# Minimum number of active entities required before compiling brief
ALMANAC_MIN_ENTITIES=2

# Redis key prefix for tracking monthly budget spent
BUDGET_REDIS_KEY_PREFIX=budget

# Budget hold threshold (multiples of cost_per_pull). If remaining budget is less, hold triggers.
BUDGET_HOLD_THRESHOLD_REMAINING=2.0

# Wavefunction scoring engine configuration
WAVEFUNCTION_SCORING_VERSION=v1-wavefunction
DIVERGENCE_SPIKE_THRESHOLD=0.7
